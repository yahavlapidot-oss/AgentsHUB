# Local SQLite file by default. For the web, point this at a hosted libSQL/Turso database.
DATABASE_URL=file:./data/agentshub.db
# Only needed for Turso.
DATABASE_AUTH_TOKEN=

# When set, the dashboard asks for this password (HTTP Basic auth, any username).
# Agent endpoints under /api/v1 use per-agent tokens instead.
DASHBOARD_PASSWORD=

# Email alerts (optional): approvals, finished tasks, stuck agents, errors. Uses resend.com.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Sender; must be a domain verified in Resend. The default only reaches your own Resend account email.
NOTIFY_FROM=
# The board's public address, used for links in emails, e.g. https://agentshub.up.railway.app
PUBLIC_URL=

# Agents AgentsHUB runs itself ("AgentsHUB runs it" on the connect screen). Set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set to 0 to turn the hosted-agent runner off.
RUNNER_ENABLED=
# How many times an hour a message can wake one idle hosted agent (default 12).
RUNNER_MAX_WAKES_PER_HOUR=
# Extra model prices in USD per million [input, output] tokens. Claude's are built in.
MODEL_PRICES=

# Cloud computers for hosted agents with "Cloud computer" on (https://e2b.dev). Without a key they work without one.
E2B_API_KEY=
# Optional limits; the defaults are shown.
SANDBOX_MAX_CONCURRENT=3
SANDBOX_TIMEOUT_MS=1800000
SANDBOX_COMMAND_TIMEOUT_MS=300000
SANDBOX_USD_PER_HOUR=0.11
# Set to 0 to turn sandboxes off everywhere (emergency switch), or to block their internet access.
SANDBOX_ENABLED=
SANDBOX_INTERNET=
# Saved files: largest single file and total per task, in bytes (5 MB and 50 MB by default).
ARTIFACT_MAX_BYTES=
ARTIFACT_MAX_TASK_BYTES=
# Database backup before each migration (on by default; 0 turns it off) and how many to keep.
BACKUP_ON_MIGRATE=
BACKUPS_KEEP=
# How many times a hosted agent may make the exact same tool call in one run (default 5).
TOOL_MAX_SAME_CALL=
