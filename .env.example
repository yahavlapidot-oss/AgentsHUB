# Local SQLite file by default. For the web, point this at a hosted libSQL/Turso database.
DATABASE_URL=file:./data/agentshub.db
# Only needed for Turso.
DATABASE_AUTH_TOKEN=

# The dashboard asks for this password (HTTP Basic auth, any username). In
# production the dashboard stays locked until it's set, unless DASHBOARD_OPEN=1.
# Agent endpoints under /api/v1 and /api/mcp use per-agent tokens instead.
DASHBOARD_PASSWORD=
DASHBOARD_OPEN=
# Largest request an agent may send (default 10 MB).
API_MAX_BODY_BYTES=
# Server problems are emailed at most once per this many ms for each kind (default 30 minutes).
ALERT_EVERY_MS=

# Email alerts (optional): approvals, finished tasks, stuck agents, errors. Uses resend.com.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Sender; must be a domain verified in Resend. The default only reaches your own Resend account email.
NOTIFY_FROM=
# The board's public address, used for links in emails, e.g. https://agentshub.up.railway.app
PUBLIC_URL=

# Agents AgentsHUB runs itself ("AgentsHUB runs it" on the connect screen). Set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set to 0 to turn the hosted-agent runner off.
RUNNER_ENABLED=
# How many times an hour a message can wake one idle hosted agent (default 12).
RUNNER_MAX_WAKES_PER_HOUR=
# Extra model prices in USD per million [input, output] tokens. Claude's are built in.
MODEL_PRICES=

# Cloud computers for hosted agents with "Cloud computer" on (https://e2b.dev). Without a key they work without one.
E2B_API_KEY=
# Optional limits; the defaults are shown.
SANDBOX_MAX_CONCURRENT=3
SANDBOX_TIMEOUT_MS=1800000
SANDBOX_COMMAND_TIMEOUT_MS=300000
SANDBOX_USD_PER_HOUR=0.11
# Set to 0 to turn sandboxes off everywhere (emergency switch), or to block their internet access.
SANDBOX_ENABLED=
SANDBOX_INTERNET=
# Saved files: largest single file and total per task, in bytes (5 MB and 50 MB by default).
ARTIFACT_MAX_BYTES=
ARTIFACT_MAX_TASK_BYTES=
# Database backup before each migration (on by default; 0 turns it off) and how many to keep.
BACKUP_ON_MIGRATE=
BACKUPS_KEEP=
# How many times a hosted agent may make the exact same tool call in one run (default 5).
TOOL_MAX_SAME_CALL=
# Keep saved files in an S3-compatible bucket (e.g. a Railway bucket) instead of the database. All four, or none.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_REGION=
# "virtual" for buckets that want the bucket name in the host (new Railway buckets); default "path".
ARTIFACT_S3_URL_STYLE=
# Context engine: token budget for a task's first message, and the size past which old tool outputs in a run get shortened.
CONTEXT_BRIEF_TOKENS=
CONTEXT_MAX_TOKENS=
# Most memories one agent may keep (default 200).
AGENT_MAX_MEMORIES=
# Approvals: hours before an undecided request expires (default 24), and minutes an approval stays valid after your OK (default 60).
APPROVAL_PENDING_HOURS=
APPROVAL_VALID_MINUTES=

# Internet for agents (web_search, fetch_page). Search uses the first key that's set:
# Tavily (1,000 free searches a month), Brave Search, or Claude's web search via ANTHROPIC_API_KEY (~$10 per 1,000 searches + tokens).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Force one: tavily | brave | claude
WEB_SEARCH_PROVIDER=
# The small model that runs Claude's web search (default claude-haiku-5-5).
WEB_SEARCH_MODEL=
WEB_FETCH_TIMEOUT_MS=
# Default time zone for schedules and the daily digest (IANA name).
APP_TIMEZONE=Asia/Jerusalem

# Telegram (optional, free): alerts, one-tap approvals, and a line to your chief of staff.
# Token from @BotFather; chat id: send /start to your bot. Then "Connect" on the Settings page.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: your own webhook secret (default: derived from the token).
TELEGRAM_WEBHOOK_SECRET=
# Push notifications to the installed app (optional, free). Settings can make a key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Voice input (chat microphone, Telegram voice messages) uses OPENAI_API_KEY; this picks the model.
VOICE_MODEL=

# --- Connections (GitHub, Google, Railway, MCP servers) ---
# Encrypts saved tokens. Any long random text (e.g. `openssl rand -hex 32`). Without it, a key
# made from DASHBOARD_PASSWORD is used, and changing the password makes saved tokens unreadable.
CONNECTIONS_KEY=
# Google sign-in for Gmail, Calendar and Drive: an OAuth client (Web application) from Google
# Cloud Console. Redirect address: <PUBLIC_URL>/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MCP_TIMEOUT_MS=60000
# Playwright version installed in cloud computers for the browser tool
# SANDBOX_PLAYWRIGHT_VERSION=1.49.1
