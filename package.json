{
  "name": "agentshub",
  "version": "0.1.0",
  "private": true,
  "description": "A Monday-style board to track AI agents: tasks, progress, agent chat, models and token usage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@libsql/client": "^0.15.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "^0.45.4",
    "e2b": "2.59.0",
    "next": "^15.5.0",
    "openai": "^7.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uqr": "0.1.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
